# Cloudflare Workers static-assets headers (Vite copies public/ into dist/).
# API responses get the equivalent headers from the Worker (worker/security.js).
#
# CSP notes - Google Identity Services (the "Sign in with Google" button) needs:
#   script-src  https://accounts.google.com/gsi/client
#   frame-src   https://accounts.google.com/gsi/
#   connect-src https://accounts.google.com/gsi/   (covered by https://accounts.google.com)
#   style-src   https://accounts.google.com/gsi/style
#   img-src     https://*.googleusercontent.com    (account avatar inside the button)
# 'wss:' lets the game open its WebSocket on whatever host serves it (Safari does not
# match 'self' against ws/wss). Inline styles are allowed because React sets style="" attributes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' https://accounts.google.com wss:; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite emits content-hashed files under /assets: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must always be revalidated so a deploy is picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The service worker must never be served stale (browsers check it for updates).
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The web app manifest: correct type, always revalidated (icons / shortcuts can change between deploys).
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

# The offline page and its script are copied into the service worker cache at install: keep them fresh.
/offline.html
  Cache-Control: no-cache
/offline.js
  Cache-Control: no-cache

# Crawler files: short cache so a change is picked up within the hour.
/robots.txt
  Cache-Control: public, max-age=3600

# Icons, the social-share image and sounds keep their names between deploys (not content-hashed): one day / one week.
/icons/*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/sfx/*
  Cache-Control: public, max-age=604800
# Voice lines (shop soundboard clips): fetched lazily, keep their names, one week.
/audio/*
  Cache-Control: public, max-age=604800
