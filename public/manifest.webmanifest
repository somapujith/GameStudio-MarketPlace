{
  "name": "Jalebi Games",
  "short_name": "Jalebi Games",
  "description": "Gully made. Game ready. Multiplayer games with a Hyderabadi street spirit.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0b0908",
  "theme_color": "#0b0908",
  "categories": ["games", "entertainment", "social"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/jalebi-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/jalebi-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Browse games",
      "short_name": "Browse",
      "description": "See every game and start a table",
      "url": "./games?source=shortcut",
      "icons": [{ "src": "icons/jalebi-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Join a table",
      "short_name": "Join",
      "description": "Enter a room code to join your friends",
      "url": "./join?source=shortcut",
      "icons": [{ "src": "icons/jalebi-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "The Adda",
      "short_name": "The Adda",
      "description": "See who is online and invite them to a game",
      "url": "./friends?source=shortcut",
      "icons": [{ "src": "icons/jalebi-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
