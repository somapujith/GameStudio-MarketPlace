{
  "name": "jalebi-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "node scripts/simulate.js",
    "worker": "wrangler dev --port 8787",
    "worker:staging": "wrangler dev --port 8787 --env-file .dev.vars.staging",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "node scripts/migrate.js",
    "migrate:staging": "node --env-file=.dev.vars.staging scripts/migrate.js",
    "deploy": "npm run build && wrangler deploy",
    "voices:gen": "node scripts/gen-voicelines.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
